# Auto detect text files and perform LF normalization
* text=auto

*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.zip binary

*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

*.lock binary